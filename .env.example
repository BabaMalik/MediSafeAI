# =============================================================================
# MediSafeAI Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# Command: cp .env.example .env

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=development
APP_NAME=MediSafeAI
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-this-in-production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Main application database
DATABASE_URL=postgresql://medisafe_user:medisafe_password@localhost:5432/medisafe_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=False

# Airflow metadata database
AIRFLOW_DATABASE_URL=postgresql://airflow_user:airflow_password@localhost:5432/airflow_db

# =============================================================================
# DIFFERENTIAL PRIVACY SETTINGS
# =============================================================================
# Default privacy budget (epsilon)
# Lower values = stronger privacy, more noise
# Recommended: 0.1 - 5.0
DEFAULT_EPSILON=1.0

# Delta parameter for relaxed differential privacy
# Recommended: 1e-5 to 1e-7
DEFAULT_DELTA=1e-5

# Privacy mechanism selection
# Options: laplace, gaussian, auto
PRIVACY_MECHANISM=auto

# Maximum privacy budget per query
MAX_EPSILON=10.0

# =============================================================================
# DATA GENERATION SETTINGS
# =============================================================================
# Default number of patients to generate
DEFAULT_NUM_PATIENTS=1000

# Random seed for reproducibility (set to 'None' for random)
RANDOM_SEED=42

# Data output directory
DATA_OUTPUT_DIR=./data/raw

# Processed data directory
DATA_PROCESSED_DIR=./data/processed

# Private data directory
DATA_PRIVATE_DIR=./data/private

# =============================================================================
# FLASK API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4
API_TIMEOUT=300
API_MAX_REQUESTS=1000
API_MAX_REQUESTS_JITTER=50

# CORS settings
CORS_ENABLED=True
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# API Authentication
API_KEY_ENABLED=False
API_KEY=your-api-key-here

# =============================================================================
# AIRFLOW CONFIGURATION
# =============================================================================
AIRFLOW_HOME=/opt/airflow
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_LOAD_EXAMPLES=False
AIRFLOW_DAGS_FOLDER=/opt/airflow/dags

# Airflow Authentication
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_FIRSTNAME=Admin
AIRFLOW_LASTNAME=User
AIRFLOW_EMAIL=admin@medisafe.ai

# Scheduler settings
AIRFLOW_SCHEDULER_HEARTBEAT_SEC=5
AIRFLOW_SCHEDULER_MIN_FILE_PROCESS_INTERVAL=30

# =============================================================================
# REDIS CONFIGURATION (for caching and Celery)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://:@localhost:6379/0

# Cache TTL in seconds
CACHE_TTL=3600
CACHE_ENABLED=True

# =============================================================================
# CELERY CONFIGURATION (for async tasks)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=True

# =============================================================================
# SPARK CONFIGURATION
# =============================================================================
SPARK_MASTER=local[*]
SPARK_APP_NAME=MediSafeAI
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=2

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# OpenTelemetry
OTEL_ENABLED=False
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=medisafe-ai
OTEL_TRACES_SAMPLER=always_on

# Prometheus
PROMETHEUS_ENABLED=False
PROMETHEUS_PORT=9090

# Logging
LOG_FORMAT=json
LOG_FILE=/var/log/medisafe/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# HIPAA Compliance
HIPAA_MODE_ENABLED=True
DATA_ENCRYPTION_ENABLED=True
ENCRYPTION_KEY=your-encryption-key-32-characters-long

# Audit logging
AUDIT_LOG_ENABLED=True
AUDIT_LOG_FILE=/var/log/medisafe/audit.log

# =============================================================================
# DISEASE SIMULATION PARAMETERS
# =============================================================================
# Disease progression parameters
DISEASE_PROGRESSION_ENABLED=True
DEFAULT_NUM_VISITS=12
DEFAULT_TIME_INTERVAL_DAYS=30

# Intervention simulation
INTERVENTION_FREQUENCY_DAYS=90
INTERVENTION_EFFECT_MIN=0.05
INTERVENTION_EFFECT_MAX=0.15

# =============================================================================
# TEMPORAL PATTERNS CONFIGURATION
# =============================================================================
# Anomaly detection
ANOMALY_PROBABILITY=0.05
ANOMALY_MULTIPLIER_MIN=1.5
ANOMALY_MULTIPLIER_MAX=2.5

# Seasonal patterns
SEASONAL_AMPLITUDE=0.1
SEASONAL_PERIOD_DAYS=365

# =============================================================================
# EMAIL NOTIFICATIONS (for Airflow alerts)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@medisafe.ai
SMTP_STARTTLS=True
SMTP_SSL=False

# =============================================================================
# AWS CONFIGURATION (for S3 storage)
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=medisafe-data
S3_ENABLED=False

# =============================================================================
# DOCKER SETTINGS
# =============================================================================
DOCKER_COMPOSE_PROJECT_NAME=medisafe
POSTGRES_VERSION=14
REDIS_VERSION=7
AIRFLOW_VERSION=2.8.1

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/test_medisafe
TEST_DATA_DIR=./tests/test_data
PYTEST_WORKERS=auto

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
JUPYTER_PORT=8888
JUPYTER_TOKEN=medisafe-dev-token
HOT_RELOAD=True
DEBUG_TOOLBAR_ENABLED=True
